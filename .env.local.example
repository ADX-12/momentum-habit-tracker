# ============================================================
# Momentum — Habit & Goal Management Platform
# Copy this file to .env.local and fill in your values
# ============================================================

# ---- Email Notifications (Resend) ----
# Get your API key at https://resend.com
# Without this, email notifications are disabled (in-app only)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@yourdomain.com

# ---- Supabase (Optional — for persistent multi-device storage) ----
# Get your URL and anon key at https://supabase.com
# Without these, the app uses localStorage (single device only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ---- App Config ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Kolkata
